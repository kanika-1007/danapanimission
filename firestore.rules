rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /settings/summary {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['donationTotal', 'memberCount', 'updatedAt'])
        && request.resource.data.donationTotal is int
        && request.resource.data.donationTotal >= 0
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 0;
      allow delete: if false;
    }

    match /settings/banner {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['driveFileId', 'updatedAt'])
        && request.resource.data.driveFileId is string
        && request.resource.data.driveFileId.matches('^[A-Za-z0-9_-]{10,200}$');
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
